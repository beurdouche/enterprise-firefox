#include "nsISupports.idl"
#include "nsICookie.idl"

[scriptable, uuid(7d3b9c45-5a6e-4d8c-b0f1-c8e2d3a4b5c6)]
interface nsIFelt : nsISupports {
  [must_use]
  ACString oneShotIpcServer();

  [must_use]
  AString binPath();

  [must_use]
  boolean makeBackgroundProcess(in boolean background);

  [must_use]
  boolean isFeltUI();

  [must_use]
  boolean isFeltBrowser();

  [must_use]
  boolean isFeltSafeMode();

  [must_use]
  void ipcChannel();

  [must_use]
  void sendBoolPreference(in ACString name, in boolean value);

  [must_use]
  void sendStringPreference(in ACString name, in ACString value);

  [must_use]
  void sendIntPreference(in ACString name, in int32_t value);

  [must_use]
  void sendCookies(in Array<nsICookie> cookies);

  [must_use]
  void sendReady();

  [must_use]
  void sendRestartForced();

  [must_use]
  void sendUpdateReady();

  [must_use]
  void sendAccessToken();

  [must_use]
  void refreshTokens();

  [must_use]
  ACString getRefreshToken();

  [must_use]
  ACString getAccessTokenIfValid();

  // expires_at is a Unix timestamp in seconds (UTC).
  [must_use]
  void setTokens(in ACString access_token, in ACString refresh_token, in long long expires_at);

  [must_use]
  void clearTokens();

  /**
   * Store the PBKDF2-stretched derivative of the user's SSO password.
   *
   * IMPORTANT: callers must pass the stretched bytes (hex), NOT the
   * raw password. Stretching happens in the Felt UI process so the
   * raw password never crosses the IPC boundary into the spawned
   * Firefox. See FeltProcessParent::_stretchSSOPasswordLocally.
   *
   * Held only in in-memory state; not persisted, not logged.
   */
  [must_use]
  void setSSOPassword(in ACString stretchedHex);

  /**
   * Push the previously-set stretched value to the spawned Firefox
   * via the existing Felt IPC channel. Mirrors sendAccessToken.
   */
  [must_use]
  void sendSSOPassword();

  /**
   * In the spawned Firefox: read the stretched-password derivative
   * previously received over IPC. Returns the empty string if none.
   * Non-consuming — multiple readers (BrowserGlue for NSS-slot mix,
   * FxAccountsKeys for kSyncPersonal derivation) can call this on
   * every use during the session. Cleared explicitly via
   * clearCapturedSSOPassword on logout.
   */
  [must_use]
  ACString peekCapturedSSOPassword();

  /**
   * In the spawned Firefox: zero the captured stretched-password
   * slot. Call on logout / sign-out so subsequent readers see an
   * empty value.
   */
  [must_use]
  void clearCapturedSSOPassword();

  /**
   * Store the console-supplied primarySecret on the Felt UI process
   * after it's fetched via ConsoleClient.getPrimarySecret(). Held in
   * memory only; never logged.
   */
  [must_use]
  void setPrimarySecret(in ACString hex);

  /**
   * Push the previously-set primarySecret to the spawned Firefox over
   * the existing Felt IPC channel. Must be invoked BEFORE the spawned
   * Firefox initializes mozStorage encryption (i.e. before
   * `sendReady()` / `firefoxReady=true`), so the storage layer can
   * unlock its Password KEK at `profile-do-change` without racing the
   * first cookies.sqlite open.
   */
  [must_use]
  void sendPrimarySecret();

  /**
   * In the spawned Firefox: read the primarySecret previously
   * received over IPC. Returns the empty string if none has arrived
   * yet. Non-consuming — `storage/SQLiteEncryption.cpp` uses this
   * synchronously on every database open + on KEK re-unlock after
   * cache expiry, so it must remain readable for the lifetime of the
   * session. Cleared explicitly via `clearPrimarySecret` on logout.
   */
  [must_use]
  ACString peekPrimarySecret();

  /**
   * In the spawned Firefox: zero the primarySecret slot. Call on
   * logout / sign-out so subsequent readers see an empty value.
   */
  [must_use]
  void clearPrimarySecret();

  [must_use]
  void sendExtensionReady();

  [must_use]
  void openURL(in ACString url, in long disposition);

  [must_use]
  ACString getConsoleUrl();

  [must_use]
  void performSignout();

  [must_use]
  void shutdownFirefox();
};

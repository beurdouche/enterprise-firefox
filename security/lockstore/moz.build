with Files("**"):
    BUG_COMPONENT = ("Core", "Security: Lockstore")

TEST_DIRS += ["tests/gtest"]

IPDL_SOURCES += [
    "PLockstore.ipdl",
]

if CONFIG["COMPILE_ENVIRONMENT"]:
    CbindgenHeader(
        "lockstore_ffi_generated.h", inputs=["/security/lockstore/lockstore_ffi"]
    )

    EXPORTS.mozilla.security.lockstore += [
        "!lockstore_ffi_generated.h",
    ]

EXPORTS.mozilla.security.lockstore += [
    "LockstoreChild.h",
    "LockstoreIPCUtils.h",
    "LockstoreParent.h",
]

UNIFIED_SOURCES += [
    "LockstoreChild.cpp",
    "LockstoreParent.cpp",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"
